    "python tools/experimental-warnings/policy.py --pack . --manifest <run>/dist/pack-manifest.json",
    "python tools/verify_public_release.py --staged <run>/dist/pack-manifest.json --out <run>/public",
    "python tools/generate_manifest.py --pack <run>/pack --out <run>/public --launcher <launcher> --verify-only"
  ]
}
